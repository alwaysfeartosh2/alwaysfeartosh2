-- Core Teleport Physics Engine Logic
local function executeTeleportPhysics()
    local char = lp.Character
    if not char then return end
    
    local hm = char:FindFirstChildOfClass("Humanoid")
    if hm and hm.SeatPart then 
        hm.Sit = false 
        task.wait(0.05) 
    end
    
    local root = char:FindFirstChild("HumanoidRootPart") or (hm and hm.RootPart)
    if not root then return end
    
    -- Optimized: Raycast calculation isolated strictly to confirmation trigger
    local targetPosition = mouse.Hit.Position

    local hh = hm and hm.HipHeight > 0 and (hm.HipHeight + 1) or 4
    root.CFrame = CFrame.new(targetPosition, Vector3.new(root.Position.X, targetPosition.Y, root.Position.Z)) * CFrame.Angles(0, math.pi, 0) + Vector3.new(0, hh, 0)
end

-- Unified Input Listener
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if listeningForKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            listeningForKey = false
            tpKeybind = input.KeyCode
            keybindBtn.Text = tostring(input.KeyCode.Name)
            keybindStroke.Color = Theme.Border
        end
        return
    end
    
    if gameProcessed or UserInputService:GetFocusedTextBox() then return end
    
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if not requireKeyAndClick and input.KeyCode == tpKeybind then 
            executeTeleportPhysics() 
        end
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
        if requireKeyAndClick and UserInputService:IsKeyDown(tpKeybind) then
            executeTeleportPhysics()
        end
    end
end)

-- Custom Mobile Backpack Tool Manager
local function updateMobileToolState()
    if tpTool then
        tpTool:Destroy()
        tpTool = nil
    end
    
    if lp.Character and lp.Character:FindFirstChild("Teleport Tool") then
        lp.Character["Teleport Tool"]:Destroy()
    end

    if showMobileToggle then
        tpTool = Instance.new("Tool")
        tpTool.Name = "Teleport Tool"
        tpTool.RequiresHandle = false
        tpTool.CanBeDropped = false
        
        tpTool.Activated:Connect(executeTeleportPhysics)
        
        local backpack = lp:WaitForChild("Backpack", 2)
        if backpack then
            tpTool.Parent = backpack
        end
    end
end

-- Character lifecycle mapper
lp.CharacterAdded:Connect(function()
    if showMobileToggle then
        task.wait(0.3)
        updateMobileToolState()
    end
end)

